{
    "//": "Design files",
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/defines.v",
        "dir::../../verilog/rtl/user_project_wrapper.v"
    ],
    "PNR_SDC_FILE": "dir::signoff.sdc",
    "VERILOG_POWER_DEFINE": "USE_POWER_PINS",
    "RUN_IRDROP_REPORT": false,
    "IGNORE_DISCONNECTED_MODULES": [
        "user_project_wrapper"
    ],

    "//": "Macros configurations. The met5 straps over the ROM are vccd1 at y = 374.3 and vssd1 at y = 392.9. At y = 320 both cross the 90.42 um ROM; at y = 300 vssd1 missed it and vgnd was left unconnected.",
    "MACROS": {
        "rom_ctrl": {
            "gds": [
                "dir::../../gds/rom_ctrl.gds"
            ],
            "lef": [
                "dir::../../lef/rom_ctrl.lef"
            ],
            "instances": {
                "u_rom_ctrl": {
                    "location": [60.00, 60.00],
                    "orientation": "N"
                }
            },
            "nl": [
                "dir::../../verilog/gl/rom_ctrl.v"
            ],
            "spef": {
                "min_*": [
                    "dir::../../spef/multicorner/rom_ctrl.min.spef"
                ],
                "nom_*": [
                    "dir::../../spef/multicorner/rom_ctrl.nom.spef"
                ],
                "max_*": [
                    "dir::../../spef/multicorner/rom_ctrl.max.spef"
                ]
            },
            "lib": {
                "*": "dir::../../lib/rom_ctrl.lib"
            }
        },
        "CF_ROM_SYNC": {
            "gds": [
                "dir::../../ip/CF_ROM_SYNC/layout/gds/CF_ROM_SYNC.gds"
            ],
            "lef": [
                "dir::../../ip/CF_ROM_SYNC/layout/lef/CF_ROM_SYNC.lef"
            ],
            "instances": {
                "u_cf_rom_sync": {
                    "location": [130.00, 320.00],
                    "orientation": "N"
                }
            },
            "nl": [
                "dir::../../ip/CF_ROM_SYNC/hdl/gl/CF_ROM_SYNC_core.v",
                "dir::../../ip/CF_ROM_SYNC/hdl/gl/CF_ROM_SYNC.v"
            ],
            "lib": {
                "*_tt_025C_1v80": "dir::../../ip/CF_ROM_SYNC/timing/lib/CF_ROM_SYNC_tt_1.80V_25C.lib",
                "*_ss_100C_1v60": "dir::../../ip/CF_ROM_SYNC/timing/lib/CF_ROM_SYNC_ss_1.60V_-40C.lib",
                "*_ff_n40C_1v95": "dir::../../ip/CF_ROM_SYNC/timing/lib/CF_ROM_SYNC_ff_1.95V_-40C.lib"
            }
        }
    },
    "PDN_MACRO_CONNECTIONS": [
        "u_rom_ctrl vccd1 vssd1 vccd1 vssd1",
        "u_cf_rom_sync vccd1 vssd1 vpwr vgnd"
    ],

    "//": "PDN. Default LibreLane met4/met5 vias onto wrap met4 PG pins.",
    "FP_PDN_HORIZONTAL_HALO": 10,
    "FP_PDN_VERTICAL_HALO": 10,
    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3.1,
    "FP_PDN_HWIDTH": 3.1,
    "FP_PDN_VSPACING": 15.5,
    "FP_PDN_HSPACING": 15.5,
    "FP_PDN_VPITCH": 180,
    "FP_PDN_HPITCH": 180,
    "ERROR_ON_PDN_VIOLATIONS": false,

    "//": "SRAM-style parent stream-out: Magic black-boxes wrap GDS (GDS_FILE + FIXED_BBOX). Skip Magic DRC on analog OBS datatypes. MAGIC_CAPTURE_ERRORS false so OBS 67/10 68/10 69/10 do not fail get_bbox. XOR vs KLayout is expected if Magic keeps DEF TAPER that KLayout drops — do not fail the flow on that.",
    "RUN_MAGIC_DRC": false,
    "MAGIC_DRC_USE_GDS": false,
    "ERROR_ON_MAGIC_DRC": false,
    "RUN_MAGIC_STREAMOUT": true,
    "RUN_MAGIC_WRITE_LEF": true,
    "MAGIC_CAPTURE_ERRORS": false,
    "PRIMARY_GDSII_STREAMOUT_TOOL": "magic",
    "MAGIC_MACRO_STD_CELL_SOURCE": "macro",
    "ERROR_ON_XOR_ERROR": false,
    "MAGIC_EXT_USE_GDS": false,
    "MAGIC_EXT_ABSTRACT_CELLS": [
        "^CF_ROM_SYNC_core$"
    ],

    "DRT_THREADS": 1,
    "MAX_TRANSITION_CONSTRAINT": 1.5,
    "//": "rom_ctrl sits at (60, 60) and GPIO 8-16 are on the far edge. A macro pin driving that route, such as gpio_out to io_out[10], had 4.1 ns slew at max_ss against the 1.5 ns limit. The repair estimate treats the wire as short. Break any wire longer than 250 um.",
    "DESIGN_REPAIR_MAX_WIRE_LENGTH": 250,
    "GRT_DESIGN_REPAIR_MAX_WIRE_LENGTH": 250,
    "DESIGN_REPAIR_MAX_SLEW_PCT": 40,
    "GRT_DESIGN_REPAIR_MAX_SLEW_PCT": 40,
    "//": "Keep the four inv_16 loads on the ROM DO net. Without this, cap repair inserts a buffer and leaves the ROM pin under its 0.111 pF minimum.",
    "RSZ_DONT_TOUCH_RX": "rom_do",

    "//": "met4/met5 sit around 50% derated from the analog obstructions above, so global routing has little slack. At the 0.3 default the router closes but leaves an m1.2 spacing violation; 0.2 signs off clean. Do not set GRT_ALLOW_CONGESTION: it lets DRT finish with shorts, which surfaces as an LVS net-count mismatch rather than a routing error.",
    "GRT_ADJUSTMENT": 0.2,
    "GRT_OVERFLOW_ITERS": 100,

    "//": "Fixed configurations for caravel. You should NOT edit this section",
    "DESIGN_NAME": "user_project_wrapper",
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 2920, 3520],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",
    "VDD_NETS": [
        "vccd1",
        "vccd2",
        "vdda1",
        "vdda2"
    ],
    "GND_NETS": [
        "vssd1",
        "vssd2",
        "vssa1",
        "vssa2"
    ],
    "FP_PDN_CORE_RING": true,
    "FP_PDN_CORE_RING_VWIDTH": 3.1,
    "FP_PDN_CORE_RING_HWIDTH": 3.1,
    "FP_PDN_CORE_RING_VOFFSET": 12.45,
    "FP_PDN_CORE_RING_HOFFSET": 12.45,
    "FP_PDN_CORE_RING_VSPACING": 1.7,
    "FP_PDN_CORE_RING_HSPACING": 1.7,
    "CLOCK_PORT": "wb_clk_i",
    "SIGNOFF_SDC_FILE": "dir::signoff.sdc",
    "MAGIC_DEF_LABELS": false,
    "CLOCK_PERIOD": 25,
    "MAGIC_ZEROIZE_ORIGIN": false,
    "meta": {
        "version": 2
    }
}
